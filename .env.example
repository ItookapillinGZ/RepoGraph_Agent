# Offline doctor, deterministic demo, trace inspection, and replay need no API key.

# Optional live model mode. Live calls may incur API charges.
CODE_REVIEW_LLM_PROVIDER=openai
CODE_REVIEW_LLM_API_KEY=replace_with_your_key
CODE_REVIEW_LLM_MODEL=gpt-5.6-luna
CODE_REVIEW_LLM_TIMEOUT_SECONDS=300
CODE_REVIEW_LLM_REASONING_EFFORT=none
CODE_REVIEW_LLM_MAX_COMPLETION_TOKENS=8192
# For an explicitly selected OpenAI-compatible provider only:
# CODE_REVIEW_LLM_BASE_URL=https://provider.example/v1

# RepoGraph Studio (trusted local development). Set these to local directories.
REPOGRAPH_WORKSPACE_ROOT=<repo-root>
REPOGRAPH_STUDIO_DATA_DIR=<local-state-directory-outside-workspace>
REPOGRAPH_STUDIO_ALLOWED_ORIGIN=http://localhost:3000
REPOGRAPH_STUDIO_MAX_CONCURRENT_RUNS=2

# Optional durable trace location. Platform default is used when omitted.
# REPOGRAPH_STATE_ROOT=<local-state-directory>

# Required only for separately approved G5B GitHub publication.
GITHUB_TOKEN=replace_with_your_token

# Trusted Docker sandbox policy. Do not source these values from a repository.
REPOGRAPH_SANDBOX_IMAGE=repograph-sandbox:local
REPOGRAPH_SANDBOX_MAX_TIMEOUT_SECONDS=300
REPOGRAPH_SANDBOX_MEMORY_MB=512
REPOGRAPH_SANDBOX_CPUS=1
REPOGRAPH_SANDBOX_PIDS=64
REPOGRAPH_SANDBOX_MAX_OUTPUT_CHARS=20000
